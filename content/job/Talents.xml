<?xml version="1.0" encoding="utf-8"?>
<Override>
  <!--成神之路-->
  <Talent identifier="cdgodway" trackedstat="godwaycount" trackedmax="1000">
    <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="1,4" sheetelementsize="128,128"/>
    <Description tag="talentdescription.cdgodway" />
    <!-- 杀敌计数触发器 -->
    <AbilityGroupEffect abilityeffecttype="OnKillCharacter">
      <Conditions>
        <AbilityConditionCharacter targettypes="Enemy">
          <Conditional maxhealth="gte 50" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <!-- 增加计数器 -->
        <CharacterAbilityGivePermanentStat statidentifier="godwaycount" value="1" removeondeath="false" />
      </Abilities>
    </AbilityGroupEffect>
    <!-- 1000杀 -->
    <AbilityGroupInterval interval="0.9">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="godwaycount" min="1000" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyafflictionsbymaxvitality="true" disabledeltatime="true">
              <Affliction identifier="cdgodwaybuff" amount="1.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>
    <AbilityGroupInterval interval="0.9">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="godwaycount" min="1000" />
        <AbilityConditionHasPermanentStat statidentifier="godwaycount_Done" min="1" invert="true" />
      </Conditions>
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="godwaycount_Done" value="1" removeondeath="false" />
      </Abilities>
    </AbilityGroupInterval>
  </Talent>
  <!--非凡赐福-->
