<?xml version="1.0" encoding="utf-8"?>
<Override>
  <Items>
    <!-- 魔药 -->
    <Item name="非凡特性" identifier="cdmenpotion" description="门途径魔药" category="Medical" maxstacksize="36" Tags="smallitem,chem,medical,syringe" allowasextracargo="true" useinhealthinterface="true" scale="0.5" impactsoundtag="impact_metal_light">
      <!--商店出售-->
      <Price baseprice="1000" sold="true">
        <Price storeidentifier="merchantcity" minavailable="1.2" />
        <Price storeidentifier="merchantresearch" minavailable="0.2" />
        <Price storeidentifier="merchantoutpost" minavailable="2" />
        <Price storeidentifier="merchantmine" minavailable="2" />
      </Price>
      <Fabricate suitablefabricators="vendingmachine" requiredtime="1" requiredmoney="1000" fabricationlimitmin="50" fabricationlimitmax="100" quality="0" />
      <InventoryIcon texture="%ModDir%/content/png/cdMedicines2.png" sourcerect="113,4,35,67" origin="0.5,0.5" />
      <Sprite texture="%ModDir%/content/png/cdMedicines2.png" sourcerect="113,4,35,67" depth="0.6" origin="0.5,0.5" />
      <Body width="35" height="65" density="10.2" waterdragcoefficient="1" />
      <MeleeWeapon canBeCombined="true" removeOnCombined="true" slots="Any,RightHand,LeftHand" aimpos="40,5" handle1="0,0" holdangle="220" reload="1.0" msg="ItemMsgPickUpSelect" HitOnlyCharacters="true">
        <RequiredSkill identifier="medical" level="60" />
        <StatusEffect type="OnSuccess" target="This" Condition="-100.0" setvalue="true" />
        <StatusEffect type="OnFailure" target="This" Condition="-100.0" setvalue="true" />
        <StatusEffect statuseffecttags="medical" type="OnSuccess" target="UseTarget" Comparison="and" interval="0.0" delay="0.0" setvalue="false" disabledeltatime="true">
          <Conditional entitytype="e Character" />
          <Conditional cdmeninfections="gte 1" />
          <!--随机改变魔药进度-->
          <Affliction identifier="cdmeninfections" strength="4" probability="0.8" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="-3" probability="0.8" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="6" probability="0.4" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="-5" probability="0.4" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="10" probability="0.2" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="-10" probability="0.2" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="20" probability="0.05" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="-20" probability="0.05" MultiplyByMaxVitality="True" />
        </StatusEffect>
        <StatusEffect statuseffecttags="medical" type="OnFailure" target="UseTarget" Comparison="and" interval="0.0" delay="0.0" setvalue="false" disabledeltatime="true">
          <Conditional entitytype="e Character" />
          <Conditional cdmeninfections="gte 1" />
          <!--随机改变魔药进度-->
          <Affliction identifier="cdmeninfections" strength="4" probability="0.8" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="-3" probability="0.8" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="5" probability="0.4" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="-5" probability="0.4" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="10" probability="0.2" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="-10" probability="0.2" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="20" probability="0.05" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="-20" probability="0.05" MultiplyByMaxVitality="True" />
        </StatusEffect>
        <StatusEffect statuseffecttags="medical" type="OnSuccess" target="UseTarget" Comparison="and" interval="0.0" delay="0.0" setvalue="false" disabledeltatime="true">
          <Conditional entitytype="e Character" />
          <Conditional cdmeninfections="lte 0" />
          <!--获得魔药进度-->
          <Affliction identifier="cdmeninfections" strength="1" probability="1" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="9" probability="0.5" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="12" probability="0.2" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="47" probability="0.1" MultiplyByMaxVitality="True" />
        </StatusEffect>
        <StatusEffect statuseffecttags="medical" type="OnFailure" target="UseTarget" Comparison="and" interval="0.0" delay="0.0" setvalue="false" disabledeltatime="true">
          <Conditional entitytype="e Character" />
          <Conditional cdmeninfections="lte 0" />
          <!--获得魔药进度-->
          <Affliction identifier="cdmeninfections" strength="1" probability="1" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="9" probability="0.5" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="12" probability="0.2" MultiplyByMaxVitality="True" />
          <Affliction identifier="cdmeninfections" strength="47" probability="0.1" MultiplyByMaxVitality="True" />
        </StatusEffect>
        <StatusEffect type="OnSuccess" target="UseTarget">
          <Conditional entitytype="eq Character" />
          <Sound file="%ModDir%/content/ogg/A1.ogg" range="500" />
        </StatusEffect>
        <StatusEffect type="OnFailure" target="UseTarget">
          <Conditional entitytype="eq Character" />
          <Sound file="%ModDir%/content/ogg/A1.ogg" range="500" />
        </StatusEffect>
        <StatusEffect type="OnImpact" target="UseTarget" multiplyafflictionsbymaxvitality="true" AllowWhenBroken="true">
          <Affliction identifier="stun" amount="0.1" />
        </StatusEffect>
        <StatusEffect type="OnBroken" target="This">
          <Remove />
        </StatusEffect>
      </MeleeWeapon>
      <Projectile characterusable="false" launchimpulse="18.0" sticktocharacters="true" launchrotation="-90" inheritstatuseffectsfrom="MeleeWeapon" inheritrequiredskillsfrom="MeleeWeapon" />
    </Item>
